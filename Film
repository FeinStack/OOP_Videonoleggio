package ca_oopvideonoleggio;

/**
 *
 * @author andre
 */
public class Film {

    String titolo;
    String regista;
    int anno;
    boolean disponibile = true;

    void noleggia() {
        if (disponibile) {
            disponibile = false;
        }
    }

    void restituisci() {
        if (!disponibile) {
            disponibile = true;
        }
    }

    void stampaInfo() {

        if (disponibile) {
            System.out.println("Titolo: " + titolo
                    + "\nRegista: " + regista + "       --> DISPONIBILE"
                    + "\nAnno: " + anno);
        } else {
            System.out.println("Titolo: " + titolo
                    + "\nRegista: " + regista + "       --> NOLEGGIATO"
                    + "\nAnno: " + anno);

        }

    }

}
